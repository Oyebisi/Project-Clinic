# SendGrid settings for contact form email sending
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM=verified-sender@example.com
CONTACT_EMAIL=hello@projectclinic.com

# EmailJS client-side configuration (public keys safe for client)
# Replace the placeholders with your EmailJS values from emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
